# =============================================================================
# SUPICARGO — FLEETBASE ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Instructions:
#   1. Copy this file into Railway → Service → Variables → Raw Editor
#   2. Replace all <PLACEHOLDER> values with your actual values
#   3. Railway-managed services use ${{ServiceName.VAR}} reference syntax
#   4. The API, Queue, and Scheduler services share most of these variables
#      → Use Railway "Shared Variables" (Project Settings) to avoid duplication
# =============================================================================

# ─── APPLICATION ──────────────────────────────────────────────────────────────

APP_NAME=SupiCargo
APP_ENV=production
APP_DEBUG=false

# Generate with: php artisan key:generate --show
# Or: openssl rand -base64 32 and prefix with "base64:"
APP_KEY=base64:<GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE>

# Set to your Railway-generated API service URL (or custom domain once you have one)
APP_URL=https://<YOUR_APPLICATION_RAILWAY_URL>

# ─── DATABASE (MySQL) ─────────────────────────────────────────────────────────
# These use Railway's variable reference syntax — Railway fills them in automatically

DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLDOMAIN}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ─── CACHE & QUEUE (Redis) ────────────────────────────────────────────────────

REDIS_HOST=${{Redis.REDISHOST}}
REDIS_PORT=${{Redis.REDISPORT}}
REDIS_PASSWORD=${{Redis.REDISPASSWORD}}

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# ─── REAL-TIME (SocketCluster) ────────────────────────────────────────────────

# Internal Railway private network hostname of the socket service
# Format: <service-name>.railway.internal
SOCKETCLUSTER_HOST=socket.railway.internal
SOCKETCLUSTER_PORT=8000
SOCKETCLUSTER_SECURE=false

# ─── FILE STORAGE (AWS S3) ────────────────────────────────────────────────────
# Used for: delivery proof photos, package labels, driver documents, etc.

FILESYSTEM_DRIVER=s3
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>
AWS_DEFAULT_REGION=<YOUR_AWS_REGION>
AWS_BUCKET=supicargo-uploads
AWS_URL=https://supicargo-uploads.s3.<YOUR_AWS_REGION>.amazonaws.com
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── EMAIL (SMTP) ─────────────────────────────────────────────────────────────
# Leave as 'log' driver for now — emails will be written to logs only
# When you get SMTP credentials, change MAIL_MAILER to 'smtp'

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@supicargo.co
MAIL_FROM_NAME=SupiCargo

# ─── FLEETBASE CORE ───────────────────────────────────────────────────────────

FLEETBASE_API_VERSION=1
FLEETBASE_SANDBOX_ENABLED=false
BROADCAST_DRIVER=socketcluster

# Sanctum (API authentication) — must match your APP_URL domain
SANCTUM_STATEFUL_DOMAINS=<YOUR_CONSOLE_RAILWAY_URL>,localhost
SESSION_DOMAIN=.railway.app

# ─── CORS ─────────────────────────────────────────────────────────────────────

CORS_ALLOWED_ORIGINS=https://<YOUR_CONSOLE_RAILWAY_URL>

# ─── LOGGING ──────────────────────────────────────────────────────────────────

LOG_CHANNEL=stderr
LOG_LEVEL=error

# ─── QUEUE SETTINGS ───────────────────────────────────────────────────────────

QUEUE_FAILED_DRIVER=database-uuids
QUEUE_DEFAULT=default
HORIZON_BALANCE=auto

# ─── SECURITY ─────────────────────────────────────────────────────────────────

# Set to comma-separated list of trusted proxies, or * for Railway's load balancer
TRUSTED_PROXIES=*

# ─── FLEETOPS EXTENSION ───────────────────────────────────────────────────────

# FleetOps Google Maps API key (for route visualization in the dashboard)
# Get a key at: https://console.cloud.google.com/apis/credentials
# Enable: Maps JavaScript API, Geocoding API, Directions API
GOOGLE_MAPS_API_KEY=<YOUR_GOOGLE_MAPS_API_KEY>

# Optional: Mapbox token for alternative map tiles
# MAPBOX_ACCESS_TOKEN=<YOUR_MAPBOX_TOKEN>

# ─── OPTIONAL: PUSH NOTIFICATIONS (for driver mobile app) ────────────────────
# Configure later when you're ready to onboard drivers to the Navigator app
# EXPO_ACCESS_TOKEN=<YOUR_EXPO_TOKEN>
# FCM_SERVER_KEY=<YOUR_FIREBASE_SERVER_KEY>

# =============================================================================
# CONSOLE-ONLY VARIABLES (add ONLY to the 'console' Railway service)
# =============================================================================

# CONSOLE_API_HOST=https://<YOUR_APPLICATION_RAILWAY_URL>
# CONSOLE_SOCKETCLUSTER_HOST=wss://<YOUR_SOCKET_RAILWAY_URL>

# =============================================================================
# SOCKETCLUSTER-ONLY VARIABLES (add ONLY to the 'socket' Railway service)
# =============================================================================

# SOCKETCLUSTER_WORKERS=2
# SOCKETCLUSTER_BROKERS=1
# SOCKETCLUSTER_OPTIONS={"origins":"https://<YOUR_CONSOLE_RAILWAY_URL>:*"}
