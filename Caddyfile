{
	frankenphp {
		num_threads 24
	}
	order php_server before file_server
	# Disable admin endpoint (not needed on Railway)
	admin off
}

# Listen on $PORT (Railway injects this dynamically, default 8000)
http://:{$PORT:8000} {
	root * /fleetbase/api/public
	encode zstd br gzip
	
	php_server {
		resolve_root_symlink
	}
}