{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FleetbaseAppAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:GetObjectAcl",
        "s3:PutObjectAcl"
      ],
      "Resource": "arn:aws:s3:::supicargo-uploads/*"
    },
    {
      "Sid": "FleetbaseListBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::supicargo-uploads"
    }
  ]
}
